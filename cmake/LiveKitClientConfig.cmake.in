@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(LiveKitClient_VERSION "@PROJECT_VERSION@")
set(LiveKitClient_SHARED @BUILD_SHARED_LIBS@)

if(NOT @BUILD_SHARED_LIBS@)
  find_dependency(Protobuf CONFIG)
  find_dependency(libwebsockets CONFIG)
  find_dependency(libuv CONFIG)
  find_dependency(ZLIB)
  find_dependency(media-capture CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/LiveKitClientTargets.cmake")

if(TARGET LiveKitClient::livekitclient)
  set_property(TARGET LiveKitClient::livekitclient PROPERTY
    MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release)
  set_property(TARGET LiveKitClient::livekitclient PROPERTY
    MAP_IMPORTED_CONFIG_MINSIZEREL Release)
endif()

check_required_components(LiveKitClient)
